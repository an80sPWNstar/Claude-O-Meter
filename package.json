{
  "name": "claude-o-meter",
  "version": "0.3.1",
  "description": "Desktop widget for Claude plan usage — session, weekly, and model-scoped limits with reset countdowns",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:linux": "electron-builder --linux AppImage deb --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.claudeometer.app",
    "productName": "Claude-O-Meter",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "settings/**/*",
      "assets/**/*",
      "onboarding/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/app-icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/images/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "maintainer": "Bryan Henson <an80sPWNstar@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/images/icon.png",
      "category": "Utility",
      "synopsis": "Desktop widget for Claude plan usage",
      "description": "Frameless desktop widget showing Claude plan usage: the 5-hour session limit, the 7-day weekly limit, and any model-scoped weekly limit, with live reset countdowns."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "build/access-notice.txt",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "Bryan Henson",
  "homepage": "https://github.com/an80sPWNstar/Claude-O-Meter",
  "desktopName": "claude-o-meter.desktop",
  "license": "MIT",
  "private": true
}
